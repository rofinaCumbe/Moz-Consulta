# Conexão com MongoDB (Atlas na Nuvem ou Local)
# Exemplo MongoDB Atlas Gratuito:
# MONGODB_URI=mongodb+srv://usuario:senha@cluster0.abcde.mongodb.net/moz_consulta?retryWrites=true&w=majority
# Exemplo MongoDB Local:
# MONGODB_URI=mongodb://localhost:27017/moz_consulta

MONGODB_URI=
MONGODB_DB_NAME=moz_consulta
